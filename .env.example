# codezdev-bot environment configuration — copy to .env and fill in real
# values (see CLAUDE.md's "Local testing" section). This file does not exist
# yet as a full port of the Python original's .env.example
# (/Users/z/Desktop/Kiro/.env.example, "every config knob with comments");
# it currently documents only the two janitor-interval knobs task #30 added,
# and grows as later tasks port more of the config surface.

# STOCK_SWEEP_INTERVAL_S — how often the periodic folder-stock janitor walks
# every product to reclaim abandoned reservations back to active/
# (accounts.py's _sweep_expired, forced periodically instead of only lazily
# on a read — internal/handlers/stocksweep.go). Default 300 (5 minutes) if
# unset. A value below 10 is raised to 10 and logged: this sweep takes the
# SAME per-product mutex the live buy path (Reserve/Finalize) takes, so too
# tight a loop contends that lock against real customer purchases — the
# sharpest edge of this port's env-driven loop intervals.
STOCK_SWEEP_INTERVAL_S=300

# RECONCILE_STUCK_INTERVAL_S — how often the report-only stuck-order
# reconcile pass runs (reconcile_stuck_orders.py's cron, `*/10 * * * *`;
# internal/handlers/reconcile.go). Read-only: it only logs an OWNER ALERT
# for paid-but-undelivered orders, never delivers or refunds. Default 600
# (10 minutes) if unset. A value below 5 is raised to 5 and logged:
# store.db is a single SQLite connection shared with every write the
# process makes, so a hot loop here still queues behind the writer.
RECONCILE_STUCK_INTERVAL_S=600
