# Binaries
/bot
/codezdev_bot
*.exe

# Python bytecode cache (helper scripts are run in place from the repo root)
__pycache__/
*.pyc

# macOS Finder cruft
.DS_Store
**/.DS_Store

# DB artifacts
*.db
*.db-shm
*.db-wal

# Env
.env

# Bot runtime state, written next to the binary at run time. accounts/ is the
# folder-state stock machine (live credential files, 0600) and orders/ holds
# reservation + delivery records; admins.json and autodelete.json are live
# operational state. None of it belongs in the repo, and accounts/ in
# particular would publish customer credentials.
/accounts/
/orders/
/admins.json
/autodelete.json
*.log

# OMC state
.omc/
!.omc/skills/
# Added by code-review-graph
.code-review-graph/

# CodeGraph index (local tool state, rebuilt on demand)
.codegraph/

# Scratch review artifacts
.otp_review_*.txt
